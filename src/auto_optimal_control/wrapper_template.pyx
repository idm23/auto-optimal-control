def rhs(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(NZ)
    cdef double[::1] ov = out
    _check(P_rhs(t, &zv[0], &pv[0], &ov[0]), "rhs")
    return out


def rhs_arc(double t, z, params=None, arc=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(arc)
    out = np.zeros(NZ)
    cdef double[::1] ov = out
    _check(P_rhs_arc(t, &zv[0], &pv[0], &av[0], &ov[0]), "rhs_arc")
    return out


def jacobian(double t, z, params=None, arc=None):
    """``dF/dz`` on an arc, shape (NZ, NZ)."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(arc)
    out = np.zeros(NZ * NZ)
    cdef double[::1] ov = out
    _check(P_jac_arc(t, &zv[0], &pv[0], &av[0], &ov[0]), "jacobian")
    return out.reshape(NZ, NZ)


def dfdp(double t, z, params=None, arc=None):
    """``dF/dp`` on an arc, shape (NZ, NP)."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(arc)
    out = np.zeros(max(NZ * NP, 1))
    cdef double[::1] ov = out
    _check(P_dfdp_arc(t, &zv[0], &pv[0], &av[0], &ov[0]), "dfdp")
    return out[:NZ * NP].reshape(NZ, NP)


def control(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(max(NU, 1))
    cdef double[::1] ov = out
    _check(P_control(t, &zv[0], &pv[0], &ov[0]), "control")
    return out[:NU]


def control_bounds(double t, z, params=None):
    """``(lower, upper)`` (NU each) of the controls; infinite where unbounded."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    lo, hi = np.zeros(max(NU, 1)), np.zeros(max(NU, 1))
    cdef double[::1] lv = lo
    cdef double[::1] hv = hi
    _check(P_control_bounds(t, &zv[0], &pv[0], &lv[0], &hv[0]), "control_bounds")
    return lo[:NU], hi[:NU]


def hamiltonian(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef double H
    _check(P_hamiltonian(t, &zv[0], &pv[0], &H), "hamiltonian")
    return H


def cost_rate(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef double L
    _check(P_cost_rate(t, &zv[0], &pv[0], &L), "cost_rate")
    return L


def switching(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(NSW1)
    cdef double[::1] ov = out
    _check(P_switching(t, &zv[0], &pv[0], &ov[0]), "switching")
    return out[:NSW]


def switching_gradient(double t, z, params=None):
    """``(dS/dt (NSW,), dS/dz (NSW, NZ), dS/dp (NSW, NP))``."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    st, sz, sp_ = np.zeros(NSW1), np.zeros(NSW1 * NZ), np.zeros(NSW1 * NP1)
    cdef double[::1] a = st
    cdef double[::1] b = sz
    cdef double[::1] c = sp_
    _check(P_switching_grad(t, &zv[0], &pv[0], &a[0], &b[0], &c[0]), "switching_gradient")
    return st[:NSW], sz[:NSW * NZ].reshape(NSW, NZ), sp_[:NSW * NP].reshape(NSW, NP)


def constraint(double t, z, params=None):
    """Path-constraint values ``g`` (NC,); ``g <= 0`` is feasible."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(NC1)
    cdef double[::1] ov = out
    _check(P_constraint(t, &zv[0], &pv[0], &ov[0]), "constraint")
    return out[:NC]


def constraint_rate(double t, z, params=None, arc=None):
    """``dg/dt`` along the flow on ``arc`` (NC,); default arc: the one ``z`` is on."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(initial_arc(t, zv[:NZ], np.asarray(pv)[:NP] if NP else None)
                            if arc is None else arc)
    out = np.zeros(NC1)
    cdef double[::1] ov = out
    _check(P_constraint_rate_arc(t, &zv[0], &pv[0], &av[0], &ov[0]), "constraint_rate")
    return out[:NC]


def kinks(double t, z, params=None, arc=None):
    """The saturation guards (NK,) on ``arc`` (default: the arc at ``(t, z)``)."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(initial_arc(t, zv[:NZ], np.asarray(pv)[:NP] if NP else None)
                            if arc is None else arc)
    out = np.zeros(NK1)
    cdef double[::1] ov = out
    _check(P_kinks_arc(t, &zv[0], &pv[0], &av[0], &ov[0]), "kinks")
    return out[:NK]


def modes(double t, z, params=None):
    """The mode functions (NM,): switching functions, then ``-g`` per path constraint."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(NM1)
    cdef double[::1] ov = out
    _check(P_modes(t, &zv[0], &pv[0], &ov[0]), "modes")
    return out[:NM]


def initial_arc(double t, z, params=None):
    """The arc at ``(t, z)``: 1 where a mode function is negative.

    That is the upper bound for a bang-bang control where its switching
    function is negative, and the penalty on for a violated path constraint.
    """
    return (modes(t, z, params) < 0).astype(np.intc)


def residual(z0, zf, nu=None, double tf=np.nan, params=None):
    """Boundary residuals (NR,). ``tf`` is used only when the final time is free."""
    cdef double[::1] a = _buffer(z0, NZ, "z0")
    cdef double[::1] b = _buffer(zf, NZ, "zf")
    cdef double[::1] c = _buffer(nu if NNU else None, NNU, "nu")
    cdef double[::1] pv = _params(params)
    out = np.zeros(max(NR, 1))
    cdef double[::1] ov = out
    _check(P_residual(&a[0], &b[0], &c[0], tf, &pv[0], &ov[0]), "residual")
    return out[:NR]


def residual_jacobian(z0, zf, nu=None, double tf=np.nan, params=None):
    """Derivatives of the residuals: dict with ``z0``, ``zf`` (NR, NZ), ``nu`` (NR, NNU),
    ``tf`` (NR,) and ``p`` (NR, NP)."""
    cdef double[::1] a = _buffer(z0, NZ, "z0")
    cdef double[::1] b = _buffer(zf, NZ, "zf")
    cdef double[::1] c = _buffer(nu if NNU else None, NNU, "nu")
    cdef double[::1] pv = _params(params)
    r0, rf = np.zeros(NR * NZ), np.zeros(NR * NZ)
    rn, rt, rp = np.zeros(max(NR * NNU, 1)), np.zeros(max(NR, 1)), np.zeros(max(NR * NP, 1))
    cdef double[::1] v0 = r0
    cdef double[::1] vf = rf
    cdef double[::1] vn = rn
    cdef double[::1] vt = rt
    cdef double[::1] vp = rp
    _check(P_residual_jac(&a[0], &b[0], &c[0], tf, &pv[0], &v0[0], &vf[0], &vn[0], &vt[0], &vp[0]),
           "residual_jacobian")
    return {"z0": r0.reshape(NR, NZ), "zf": rf.reshape(NR, NZ),
            "nu": rn[:NR * NNU].reshape(NR, NNU), "tf": rt[:NR], "p": rp[:NR * NP].reshape(NR, NP)}


def stm_jump(int k, double t, y, params=None, arc=None, param_sensitivity=False):
    """Apply the switch-k jump to ``y = [z, Phi(, Psi)]`` (arc = the arc before); returns a copy."""
    cdef Py_ssize_t ny = NZ + NZ * NZ + (NZ * NP if param_sensitivity else 0)
    out = _buffer(y, ny, "y")
    cdef double[::1] yv = out
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(arc)
    _check(P_stm_jump(k, t, &yv[0], &pv[0], &av[0], 1 if param_sensitivity else 0), "stm_jump")
    return out


# -----------------------------------------------------------------------------
# Arc-by-arc propagation with the state transition matrix
# -----------------------------------------------------------------------------

cdef enum:
    STATUS_TOO_MANY_SWITCHES = -2
    STATUS_JUMP_FAILED = -3
    STATUS_CONSTRAINT_VIOLATED = -4

STATUS_VIOLATED = STATUS_CONSTRAINT_VIOLATED


cdef struct _switch_ctx:
    _ctx* c
    const int* kind     # per FNI event: its index among the NE (modes, rates, kinks)
    int stm
    double* sw_t
    int* sw_k
    Py_ssize_t* n_sw
    Py_ssize_t max_sw   # with kinks, FNI's reset limit is off and this one counts switches
    int jump_failed
    int violated
    int too_many


cdef int _flag_after(int k, double t, const double* y, _ctx* c) noexcept nogil:
    """Arc flag ``k`` just after its mode function crosses zero at ``t``.

    The flag follows the side the flow moves to, from the sign of the mode
    function's rate there: a path constraint's flag is 1 when ``dg/dt > 0``
    (entering the violated side), a bang-bang flag 1 (upper bound) when
    ``dS/dt < 0``. So a "crossing" that rounding reports where the function
    starts at zero leaves the flag alone. A tangential zero (rate 0) flips it."""
    cdef double Gd[NC1]
    cdef double St[NSW1]
    cdef double Sz[NSW1 * NZ]
    cdef double Sp[NSW1 * NP1]
    cdef double F[NZ]
    cdef double Sdot
    cdef int i
    if k >= NSW and P_constraint_rate_arc(t, y, c.p, c.arc, Gd) == 0:
        if Gd[k - NSW] > 0:
            return 1
        if Gd[k - NSW] < 0:
            return 0
    if k < NSW and P_switching_grad(t, y, c.p, St, Sz, Sp) == 0 \
            and P_rhs_arc(t, y, c.p, c.arc, F) == 0:
        Sdot = St[k]
        for i in range(NZ):
            Sdot += Sz[k * NZ + i] * F[i]
        if Sdot < 0:
            return 1
        if Sdot > 0:
            return 0
    return 1 - c.arc[k]


cdef int _switch_reset(Py_ssize_t event, double t, double* y, Py_ssize_t n,
                       void* ctx) noexcept nogil:
    """FNI reset map at a mode change: record it, jump the STM, set the arc.

    A path constraint marked to stop ends the integration when it becomes
    violated."""
    cdef _switch_ctx* r = <_switch_ctx*> ctx
    cdef int k = r.kind[event]
    if k >= NM:
        return FNI_RESET_CONTINUE       # a saturation kink: restart the step there
    if r.n_sw[0] >= r.max_sw:
        r.too_many = 1
        return FNI_RESET_STOP
    cdef int flag = _flag_after(k, t, y, r.c)
    if k < NSW and flag == r.c.arc[k]:
        return FNI_RESET_CONTINUE       # already on that side: not a switch
    r.sw_t[r.n_sw[0]] = t
    r.sw_k[r.n_sw[0]] = k
    r.n_sw[0] += 1
    if k >= NSW and flag == 1 and r.c.stop_on[k - NSW]:
        r.violated = 1
        return FNI_RESET_STOP
    if r.stm and k < NSW and P_stm_jump(k, t, y, r.c.p, r.c.arc, r.c.with_p) != 0:
        r.jump_failed = 1
        return FNI_RESET_STOP
    r.c.arc[k] = flag
    return FNI_RESET_CONTINUE


cdef inline fni_rhs_fn fn_of(int stm) noexcept nogil:
    return _stm_fn if stm else _rhs_arc_fn


cdef int _propagate(int method, _ctx* ctx, int stm, Py_ssize_t ny, double t0, double* y,
                    double t1, const fni_options* opt, double* y_out, double* sw_t,
                    int* sw_k, Py_ssize_t max_sw, Py_ssize_t* n_sw, Py_ssize_t* nfev,
                    int* status, double* t_final) noexcept nogil:
    """One hybrid integration in FNI: each mode function is a guard, and its
    reset map jumps the STM (saltation matrix) and sets the arc. Each path
    constraint also gets a plain event on ``dg/dt`` (no reset): FNI splits the
    step at its roots, the peaks and troughs of ``g``, so a violation that
    starts and ends inside one step is still found."""
    cdef fni_event events[NE1]
    cdef _ev_ctx evc[NE1]
    cdef int kind[NE1]
    cdef fni_hybrid_options hopt
    cdef _switch_ctx rctx
    cdef fni_stats st
    cdef int k, rc
    cdef Py_ssize_t i, ne = 0

    n_sw[0] = 0
    for k in range(NC if ctx.constraint_events else 0):
        if ctx.stop_on[k] and ctx.arc[NSW + k]:
            # Already violated at t0: stop before the first step.
            for i in range(ny):
                y_out[i] = y[i]
            nfev[0] = 0
            t_final[0] = t0
            status[0] = STATUS_CONSTRAINT_VIOLATED
            return FNI_OK
    for k in range(NE):
        if not ctx.constraint_events and NSW <= k < NM + NC:
            continue                    # the path constraints' guards
        evc[ne].p = ctx.p
        evc[ne].arc = ctx.arc
        kind[ne] = k
        if k < NM:
            evc[ne].k = k
            events[ne].fn = _event_fn
        elif k < NM + NC:
            evc[ne].k = k - NM
            events[ne].fn = _rate_fn
        else:
            evc[ne].k = k - NM - NC
            events[ne].fn = _kink_fn
        events[ne].ctx = &evc[ne]
        events[ne].direction = 0.0
        # Mode and kink guards stop the step (a reset); the peaks of g only split it.
        events[ne].max_events = INFINITY if NM <= k < NM + NC else 1.0
        ne += 1
    hopt.max_resets = -1 if NK else max_sw
    hopt.min_dwell = 0.0
    hopt.reselect_step = False
    rctx.c = ctx
    rctx.kind = kind
    rctx.stm = stm
    rctx.sw_t = sw_t
    rctx.sw_k = sw_k
    rctx.n_sw = n_sw
    rctx.max_sw = max_sw
    rctx.jump_failed = 0
    rctx.violated = 0
    rctx.too_many = 0
    rc = fni_integrate_hybrid(method, fn_of(stm), ctx, ny, t0, y, t1, opt, events, ne,
                              _switch_reset, &rctx, &hopt, y_out, NULL, NULL, NULL, NULL,
                              NULL, 0, &st, NULL)
    nfev[0] = st.nfev
    t_final[0] = st.t_final
    if rc != FNI_OK:
        return rc
    if rctx.violated:
        status[0] = STATUS_CONSTRAINT_VIOLATED
    elif rctx.jump_failed:
        status[0] = STATUS_JUMP_FAILED
    elif rctx.too_many or st.status == FNI_STATUS_RESET_LIMIT:
        status[0] = STATUS_TOO_MANY_SWITCHES
    else:
        status[0] = st.status
    return FNI_OK


cdef int _setup_options(fni_options* opt, double rtol, double atol, first_step,
                        double max_step, Py_ssize_t n_interior) except -1:
    if not max_step > 0:
        raise ValueError("max_step must be positive")
    if n_interior < 0:
        raise ValueError("n_interior must be non-negative")
    fni_options_init(opt)
    if NC and n_interior:
        opt.event_detection = FNI_EVENTS_INTERIOR
        opt.n_interior = n_interior
    opt.rtol = rtol
    opt.atol = atol
    opt.first_step = -1.0 if first_step is None else float(first_step)
    opt.max_step = max_step
    return 0


def _layout(stm, param_sensitivity, cost):
    if param_sensitivity and not stm:
        raise ValueError("param_sensitivity requires stm=True")
    return NZ + (NZ * NZ if stm else 0) + (NZ * NP if param_sensitivity else 0) + (1 if cost else 0)


def _split_events(times, index):
    """Bang-bang switches and path-constraint crossings, from the combined event record."""
    times = np.asarray(times)
    index = np.asarray(index, dtype=np.intp)
    sw = index < NSW
    return times[sw], index[sw], times[~sw], index[~sw] - NSW


def _split_events_rows(times, index, n):
    """:func:`_split_events` for padded (m, width) arrays with ``n`` valid entries per row."""
    m, width = index.shape
    valid = np.arange(width)[None, :] < n[:, None]
    out = []
    for keep in (valid & (index < NSW), valid & (index >= NSW)):
        order = np.argsort(~keep, axis=1, kind="stable")
        count = keep.sum(axis=1)
        t = np.take_along_axis(times, order, axis=1)
        k = np.take_along_axis(index, order, axis=1)
        pad = np.arange(width)[None, :] >= count[:, None]
        t = np.where(pad, np.nan, t)
        k = np.where(pad, -1, k)
        out.append((t, k, count))
    (st, sk, sn), (ct, ck, cn) = out
    ck = np.where(ck >= 0, ck - NSW, -1)
    return st, sk, sn, ct, ck, cn


def _initial_y(z, stm, Py_ssize_t ny):
    y = np.zeros(ny)
    y[:NZ] = z
    if stm:
        y[NZ:NZ + NZ * NZ] = np.eye(NZ).reshape(-1)
    return y


def propagate(double t0, z0, double t1, params=None, *, stm=False, param_sensitivity=False,
              cost=False, arc=None, method="DOP853", double rtol=1e-10, double atol=1e-12,
              first_step=None, double max_step=np.inf, Py_ssize_t max_switches=10000,
              terminate=False, Py_ssize_t n_interior=4, constraint_events=True):
    """Integrate the extremal from ``z0 = [x0, lambda0]`` from ``t0`` to ``t1``.

    The integration runs arc by arc and stops at every switch, so each
    bang-bang arc is integrated with its control fixed and no step straddles
    a discontinuity. Every crossing of a path constraint's ``g = 0`` is
    located the same way, and its penalty (if it has one) switches on or off
    there. Runs without the GIL. This is the forward map
    ``lambda0 -> trajectory``; it knows nothing about how ``lambda0`` was chosen.

    Parameters
    ----------
    stm : bool
        Also propagate the state transition matrix ``Phi = dz(t1)/dz(t0)``,
        including its jump at every switch.
    param_sensitivity : bool
        Also propagate ``Psi = dz(t1)/dp`` (requires ``stm``).
    cost : bool
        Also accumulate ``J = int_{t0}^{t1} L dt`` (the running cost at ``u*``).
    arc : array_like of 0/1, optional
        The ``N_MODES`` flags at ``t0`` (see :class:`ArcDynamics`). By
        default, from the signs of the mode functions.
    max_switches : int
        The most mode changes (switches and constraint crossings) allowed.
    terminate : bool, int, str or sequence
        Path constraints that stop the integration when they become violated:
        ``True`` for all, or their indices or names. The result then has
        status -4 and ``t`` is the time of the violation (``t0`` if ``z0``
        already violates one).
    n_interior : int
        With path constraints, also test the guards' signs at this many
        points inside every step (FNI's ``event_detection="interior"``), so a
        peak and a trough of ``g`` in the same step are told apart. ``0``
        tests only the ends of each step. The peaks and troughs of ``g`` are
        guards too, so between test points ``g`` crosses zero at most once.
    constraint_events : bool
        ``False`` ignores the path constraints: no crossings are located and
        their penalties stay off. Exact multi-arc shooting uses this on the
        arcs where the limit is inactive.

    Returns
    -------
    dict
        ``t`` (final time), ``z`` (NZ,), ``stm`` (NZ, NZ) or None, ``dz_dp``
        (NZ, NP) or None, ``cost`` (float) or None, ``dz_dt1`` (the dynamics
        at the end, NZ), ``switch_times``, ``switch_index``,
        ``constraint_times``, ``constraint_index`` (crossings of ``g = 0``, in
        either direction), ``arc0``, ``arc`` (final), ``nfev`` and ``status``
        (0 finished, -1 step size too small, -2 too many switches, -3
        tangential switch, -4 path constraint violated).
    """
    cdef fni_options opt
    cdef _ctx ctx
    cdef Py_ssize_t ny, n_sw = 0, nfev = 0, k
    cdef int status = 0, meth, rc
    cdef double t_final = t0
    cdef int do_stm = 1 if stm else 0

    ny = _layout(stm, param_sensitivity, cost)
    if method not in _METHODS:
        raise ValueError(f"method must be one of {list(_METHODS)}")
    meth = _METHODS[method]
    if max_switches < 0:
        raise ValueError("max_switches must be >= 0")
    _setup_options(&opt, rtol, atol, first_step, max_step, n_interior)
    z = _buffer(z0, NZ, "z0")
    p_arr = _params(params)
    arc0 = initial_arc(t0, z[:NZ], p_arr[:NP] if NP else None) if arc is None else _arc(arc)[:NM]
    if not constraint_events:
        arc0 = np.array(arc0, dtype=np.intc)
        arc0[NSW:] = 0
    arc_buf = _arc(arc0)
    stop = _stop_mask(terminate)

    y = _initial_y(z[:NZ], stm, ny)
    y_out = np.zeros(ny)
    sw_t = np.zeros(max(max_switches, 1))
    sw_k = np.zeros(max(max_switches, 1), dtype=np.intc)

    cdef double[::1] pv = p_arr
    cdef double[::1] yv = y
    cdef double[::1] yo = y_out
    cdef double[::1] tv = sw_t
    cdef int[::1] kv = sw_k
    ctx.p = &pv[0]
    ctx.with_p = 1 if param_sensitivity else 0
    ctx.with_cost = 1 if cost else 0
    ctx.constraint_events = 1 if constraint_events else 0
    for k in range(NM):
        ctx.arc[k] = arc_buf[k]
    for k in range(NC1):
        ctx.stop_on[k] = stop[k]

    with nogil:
        rc = _propagate(meth, &ctx, do_stm, ny, t0, &yv[0], t1, &opt, &yo[0], &tv[0], &kv[0],
                        max_switches, &n_sw, &nfev, &status, &t_final)
    if rc != FNI_OK:
        raise RuntimeError(f"integration failed with code {rc}")

    arc_end = np.array([ctx.arc[k] for k in range(NM)], dtype=np.intc)
    o = NZ + NZ * NZ
    st, sk, ct, ck = _split_events(sw_t[:n_sw], sw_k[:n_sw])
    return {
        "t": t_final,
        "z": y_out[:NZ].copy(),
        "stm": y_out[NZ:o].reshape(NZ, NZ).copy() if stm else None,
        "dz_dp": y_out[o:o + NZ * NP].reshape(NZ, NP).copy() if param_sensitivity else None,
        "cost": float(y_out[ny - 1]) if cost else None,
        "dz_dt1": rhs_arc(t_final, y_out[:NZ], p_arr[:NP] if NP else None,
                          arc_end if NM else None),
        "switch_times": st.copy(),
        "switch_index": sk,
        "constraint_times": ct.copy(),
        "constraint_index": ck,
        "arc0": np.asarray(arc0, dtype=np.intc),
        "arc": arc_end,
        "nfev": nfev,
        "status": status,
    }


cdef int _propagate_rows(int meth, int do_stm, int with_p, int with_cost, Py_ssize_t ny,
                         const double* p, const double[::1] t0, const double[::1] t1,
                         double[:, ::1] y, double[:, ::1] y_out, const int[:, ::1] arc0,
                         int[:, ::1] arc_end, double[:, ::1] sw_t, int[:, ::1] sw_k,
                         Py_ssize_t max_sw, Py_ssize_t[::1] n_sw, Py_ssize_t[::1] nfev,
                         int[::1] status, double[::1] t_final, const fni_options* opt,
                         const int* stop_on, Py_ssize_t start, Py_ssize_t stop) noexcept nogil:
    cdef _ctx ctx
    cdef Py_ssize_t r, k
    cdef int rc
    ctx.p = p
    ctx.with_p = with_p
    ctx.with_cost = with_cost
    ctx.constraint_events = 1
    for k in range(NC1):
        ctx.stop_on[k] = stop_on[k]
    for r in range(start, stop):
        for k in range(NM):
            ctx.arc[k] = arc0[r, k]
        rc = _propagate(meth, &ctx, do_stm, ny, t0[r], &y[r, 0], t1[r], opt, &y_out[r, 0],
                        &sw_t[r, 0], &sw_k[r, 0], max_sw, &n_sw[r], &nfev[r], &status[r],
                        &t_final[r])
        if rc != FNI_OK:
            return rc
        for k in range(NM):
            arc_end[r, k] = ctx.arc[k]
    return FNI_OK


def propagate_batch(t0, z0, t1, params=None, *, stm=False, param_sensitivity=False, cost=False,
                    arc=None, method="DOP853", double rtol=1e-10, double atol=1e-12,
                    first_step=None, double max_step=np.inf, Py_ssize_t max_switches=64,
                    n_threads=1, terminate=False, Py_ssize_t n_interior=4):
    """:func:`propagate` for many initial states at once, without the GIL.

    ``z0`` has shape (m, NZ); ``t0`` and ``t1`` are scalars or length-m
    arrays. All rows share ``params``. With ``n_threads > 1`` the rows are
    split across threads that run in parallel. Each row gives exactly the
    result of :func:`propagate`.

    Returns a dict of arrays with a leading dimension m: ``t``, ``z``,
    ``stm``, ``dz_dp``, ``cost`` (None when not requested), ``switch_times``
    (m, max_switches; NaN past ``n_switches``), ``switch_index`` (-1 past it),
    ``n_switches``, ``constraint_times``, ``constraint_index`` and
    ``n_crossings`` (padded the same way), ``arc0``, ``arc``, ``nfev`` and
    ``status``. ``max_switches`` bounds switches and crossings together.
    """
    cdef fni_options opt
    cdef Py_ssize_t m, ny, r, k
    cdef int meth
    from concurrent.futures import ThreadPoolExecutor

    ny = _layout(stm, param_sensitivity, cost)
    if method not in _METHODS:
        raise ValueError(f"method must be one of {list(_METHODS)}")
    meth = _METHODS[method]
    if max_switches < 0:
        raise ValueError("max_switches must be >= 0")
    _setup_options(&opt, rtol, atol, first_step, max_step, n_interior)
    Z = np.array(z0, dtype=np.float64, ndmin=2)
    if Z.ndim != 2 or Z.shape[1] != NZ:
        raise ValueError(f"z0 must have shape (m, {NZ})")
    m = Z.shape[0]
    t0_arr = np.array(np.broadcast_to(np.asarray(t0, dtype=np.float64), (m,)))
    t1_arr = np.array(np.broadcast_to(np.asarray(t1, dtype=np.float64), (m,)))
    p_arr = _params(params)
    stop = _stop_mask(terminate)
    arcs0 = np.zeros((m, NM1), dtype=np.intc)
    if arc is None:
        for r in range(m):
            arcs0[r, :NM] = initial_arc(t0_arr[r], Z[r], p_arr[:NP] if NP else None)
    else:
        a = np.asarray(arc).reshape(-1, NM) if NM else np.zeros((1, 0))
        arcs0[:, :NM] = np.broadcast_to(a, (m, NM))
        if not np.all((arcs0 == 0) | (arcs0 == 1)):
            raise ValueError("arc flags must be 0 or 1")

    y = np.zeros((m, ny))
    y[:, :NZ] = Z
    if stm:
        y[:, NZ:NZ + NZ * NZ] = np.eye(NZ).reshape(-1)
    y_out = np.zeros((m, ny))
    arc_end = np.zeros((m, NM1), dtype=np.intc)
    msw = max(max_switches, 1)
    sw_t = np.full((m, msw), np.nan)
    sw_k = np.full((m, msw), -1, dtype=np.intc)
    n_sw = np.zeros(m, dtype=np.intp)
    nfev = np.zeros(m, dtype=np.intp)
    status = np.zeros(m, dtype=np.intc)
    t_final = np.zeros(m)

    cdef const double[::1] pv = p_arr
    cdef const double[::1] t0v = t0_arr
    cdef const double[::1] t1v = t1_arr
    cdef double[:, ::1] yv = y
    cdef double[:, ::1] yov = y_out
    cdef const int[:, ::1] a0v = arcs0
    cdef int[:, ::1] aev = arc_end
    cdef double[:, ::1] swtv = sw_t
    cdef int[:, ::1] swkv = sw_k
    cdef Py_ssize_t[::1] nswv = n_sw
    cdef Py_ssize_t[::1] nfv = nfev
    cdef int[::1] stv = status
    cdef double[::1] tfv = t_final
    cdef int do_stm = 1 if stm else 0
    cdef int with_p = 1 if param_sensitivity else 0
    cdef int with_cost = 1 if cost else 0
    cdef const int[::1] stopv = stop

    def run(Py_ssize_t start, Py_ssize_t stop):
        cdef int rc
        with nogil:
            rc = _propagate_rows(meth, do_stm, with_p, with_cost, ny, &pv[0], t0v, t1v, yv, yov,
                                 a0v, aev, swtv, swkv, max_switches, nswv, nfv, stv, tfv, &opt,
                                 &stopv[0], start, stop)
        if rc != FNI_OK:
            raise RuntimeError(f"integration failed with code {rc}")

    if m:
        n_threads = max(1, min(int(n_threads), m))
        if n_threads == 1:
            run(0, m)
        else:
            bounds = np.linspace(0, m, n_threads + 1).astype(int)
            with ThreadPoolExecutor(n_threads) as pool:
                for fut in [pool.submit(run, int(a), int(b)) for a, b in zip(bounds[:-1], bounds[1:])]:
                    fut.result()

    o = NZ + NZ * NZ
    st, sk, sn, ct, ck, cn = _split_events_rows(sw_t[:, :max_switches],
                                                sw_k[:, :max_switches].astype(np.intp), n_sw)
    return {
        "t": t_final,
        "z": y_out[:, :NZ].copy(),
        "stm": y_out[:, NZ:o].reshape(m, NZ, NZ).copy() if stm else None,
        "dz_dp": y_out[:, o:o + NZ * NP].reshape(m, NZ, NP).copy() if param_sensitivity else None,
        "cost": y_out[:, ny - 1].copy() if cost else None,
        "switch_times": st,
        "switch_index": sk,
        "n_switches": sn.astype(np.intp),
        "constraint_times": ct,
        "constraint_index": ck,
        "n_crossings": cn.astype(np.intp),
        "arc0": arcs0[:, :NM].copy(),
        "arc": arc_end[:, :NM].copy(),
        "nfev": nfev,
        "status": status,
    }


# -----------------------------------------------------------------------------
# Exact boundary arcs: riding a path constraint g = 0
# -----------------------------------------------------------------------------

def _exact(c):
    if isinstance(c, str):
        c = CONSTRAINT_NAMES.index(c)
    c = int(c)
    if not 0 <= c < NC:
        raise ValueError(f"path constraint index {c} out of range ({NC} constraints)")
    if not EXACT_ARCS[c]:
        raise ValueError(f"path constraint {CONSTRAINT_NAMES[c]!r} has no exact boundary arc "
                         "(see PontryaginSystem.path_constraints[c].unsupported)")
    return c


cdef struct _b_ctx:
    const double* p
    int c


cdef int _b_rhs_fn(double t, const double* y, double* dydt, Py_ssize_t n, void* ctx) noexcept nogil:
    cdef _b_ctx* b = <_b_ctx*> ctx
    cdef int rc = P_b_rhs(b.c, t, y, b.p, dydt)
    if rc == 0 and n == NZ + 1:
        rc = P_b_cost_rate(b.c, t, y, b.p, &dydt[NZ])
    return rc


cdef int _b_stm_fn(double t, const double* y, double* dydt, Py_ssize_t n, void* ctx) noexcept nogil:
    cdef _b_ctx* b = <_b_ctx*> ctx
    cdef int rc = P_b_stm_rhs(b.c, t, y, b.p, dydt)
    if rc == 0 and n == NZ + NZ * NZ + 1:
        rc = P_b_cost_rate(b.c, t, y, b.p, &dydt[n - 1])
    return rc


cdef class BoundaryDynamics(OdeSystem):
    """``z' = F_b(t, z, p)`` while path constraint ``c`` is active (``g = 0``).

    The control is the boundary control that keeps ``g^(q) = 0``. The costates
    follow ``-d(H + mu g^(q))/dx``.
    """

    cdef _b_ctx ctx

    def __init__(self, c, params=None):
        self.n_states = NZ
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.ctx.p = self._params_ptr()
        self.ctx.c = _exact(c)
        self.c_fn = _b_rhs_fn
        self.c_ctx = &self.ctx


def boundary_rhs(c, double t, z, params=None):
    """``F_b(t, z, p)`` (NZ,) on a boundary arc of constraint ``c``."""
    cdef int k = _exact(c)
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(NZ)
    cdef double[::1] ov = out
    _check(P_b_rhs(k, t, &zv[0], &pv[0], &ov[0]), "boundary_rhs")
    return out


def boundary_jacobian(c, double t, z, params=None):
    """``dF_b/dz`` (NZ, NZ)."""
    cdef int k = _exact(c)
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(NZ * NZ)
    cdef double[::1] ov = out
    _check(P_b_jac(k, t, &zv[0], &pv[0], &ov[0]), "boundary_jacobian")
    return out.reshape(NZ, NZ)


def boundary_control(c, double t, z, params=None):
    """The control (NU,) that keeps constraint ``c`` at ``g = 0``."""
    cdef int k = _exact(c)
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(max(NU, 1))
    cdef double[::1] ov = out
    _check(P_b_control(k, t, &zv[0], &pv[0], &ov[0]), "boundary_control")
    return out[:NU]


def boundary_multiplier(c, double t, z, params=None):
    """``mu`` of ``H + mu g^(q)`` on a boundary arc of constraint ``c``."""
    cdef int k = _exact(c)
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef double mu = 0.0
    _check(P_b_multiplier(k, t, &zv[0], &pv[0], &mu), "boundary_multiplier")
    return mu


def hamiltonian_gradient(double t, z, params=None, boundary=None):
    """``(dH/dt, dH/dz)`` at ``u*``, or along a boundary arc of constraint ``boundary``."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef double Ht = 0.0
    out = np.zeros(NZ)
    cdef double[::1] ov = out
    cdef int k
    if boundary is None:
        _check(P_hamiltonian_grad(t, &zv[0], &pv[0], &Ht, &ov[0]), "hamiltonian_gradient")
    else:
        k = _exact(boundary)
        _check(P_b_hamiltonian_grad(k, t, &zv[0], &pv[0], &Ht, &ov[0]), "hamiltonian_gradient")
    return Ht, out


def boundary_hamiltonian(c, double t, z, params=None):
    """``H`` at the boundary control of constraint ``c``."""
    cdef int k = _exact(c)
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef double H = 0.0
    _check(P_b_hamiltonian(k, t, &zv[0], &pv[0], &H), "boundary_hamiltonian")
    return H


def tangency(c, double t, z, params=None):
    """``N = (g, ..., g^(q-1))`` (q,) for constraint ``c`` of order ``q``."""
    cdef int k = _exact(c)
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(QMAX)
    cdef double[::1] ov = out
    _check(P_b_tangency(k, t, &zv[0], &pv[0], &ov[0]), "tangency")
    return out[:CONSTRAINT_ORDERS[k]]


def tangency_gradient(c, double t, z, params=None):
    """``(dN/dt (q,), dN/dx (q, n), d2N/dx2 (q, n, n), d2N/dxdt (q, n))``."""
    cdef int k = _exact(c)
    cdef int q = CONSTRAINT_ORDERS[k]
    cdef int n = NZ // 2
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    nt = np.zeros(QMAX)
    nx = np.zeros(QMAX * n)
    nxx = np.zeros(QMAX * n * n)
    nxt = np.zeros(QMAX * n)
    cdef double[::1] a = nt
    cdef double[::1] b = nx
    cdef double[::1] cc = nxx
    cdef double[::1] d = nxt
    _check(P_b_tangency_grad(k, t, &zv[0], &pv[0], &a[0], &b[0]), "tangency_gradient")
    _check(P_b_tangency_hess(k, t, &zv[0], &pv[0], &cc[0], &d[0]), "tangency_gradient")
    return (nt[:q], nx.reshape(QMAX, n)[:q], nxx.reshape(QMAX, n, n)[:q],
            nxt.reshape(QMAX, n)[:q])


def propagate_boundary(c, double t0, z0, double t1, params=None, *, stm=False, cost=False,
                       method="DOP853", double rtol=1e-10, double atol=1e-12, first_step=None,
                       double max_step=np.inf):
    """Integrate along a boundary arc of constraint ``c`` from ``t0`` to ``t1``.

    No events are watched: the arc's control holds ``g^(q) = 0``, so ``g``
    stays at zero if ``N = 0`` at ``t0``. Returns a dict with ``t``, ``z``,
    ``stm`` (NZ, NZ) or None, ``cost`` or None, ``dz_dt1``, ``nfev`` and
    ``status``.
    """
    cdef _b_ctx ctx
    cdef fni_options opt
    cdef fni_stats st
    cdef int rc, meth
    cdef Py_ssize_t ny = NZ + (NZ * NZ if stm else 0) + (1 if cost else 0)
    ctx.c = _exact(c)
    if method not in _METHODS:
        raise ValueError(f"method must be one of {list(_METHODS)}")
    meth = _METHODS[method]
    _setup_options(&opt, rtol, atol, first_step, max_step, 0)
    p_arr = _params(params)
    y = _initial_y(_buffer(z0, NZ, "z0")[:NZ], stm, ny)
    y_out = np.zeros(ny)
    cdef double[::1] pv = p_arr
    cdef double[::1] yv = y
    cdef double[::1] yo = y_out
    cdef fni_rhs_fn fn = _b_stm_fn if stm else _b_rhs_fn
    ctx.p = &pv[0]
    with nogil:
        rc = fni_integrate(meth, fn, &ctx, ny, t0, &yv[0], t1,
                           &opt, NULL, 0, &yo[0], NULL, NULL, NULL, 0, &st)
    if rc != FNI_OK:
        raise RuntimeError(f"integration failed with code {rc}")
    return {
        "t": st.t_final,
        "z": y_out[:NZ].copy(),
        "stm": y_out[NZ:NZ + NZ * NZ].reshape(NZ, NZ).copy() if stm else None,
        "cost": float(y_out[ny - 1]) if cost else None,
        "dz_dt1": boundary_rhs(ctx.c, st.t_final, y_out[:NZ], p_arr[:NP] if NP else None),
        "nfev": st.nfev,
        "status": st.status,
    }
