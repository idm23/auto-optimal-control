cdef struct _ctx:
    const double* p
    int arc[NM1]
    int stop_on[NC1]    # stop when path constraint c becomes violated
    int with_p
    int with_cost       # last entry of the state is J = int L dt
    int constraint_events   # 0: path constraints are not watched (exact multi-arc shooting)


cdef struct _ev_ctx:
    const double* p
    const int* arc      # constraint rates and kinks only: the arc the flow is on
    int k


cdef int _rhs_fn(double t, const double* y, double* dydt, Py_ssize_t n, void* ctx) noexcept nogil:
    return P_rhs(t, y, <const double*> ctx, dydt)


cdef int _rhs_arc_fn(double t, const double* y, double* dydt, Py_ssize_t n, void* ctx) noexcept nogil:
    cdef _ctx* c = <_ctx*> ctx
    cdef int rc = P_rhs_arc(t, y, c.p, c.arc, dydt)
    if rc == 0 and c.with_cost:
        rc = P_cost_rate_arc(t, y, c.p, c.arc, &dydt[n - 1])
    return rc


cdef int _stm_fn(double t, const double* y, double* dydt, Py_ssize_t n, void* ctx) noexcept nogil:
    cdef _ctx* c = <_ctx*> ctx
    cdef int rc = P_stm_rhs(t, y, c.p, c.arc, c.with_p, dydt)
    if rc == 0 and c.with_cost:
        rc = P_cost_rate_arc(t, y, c.p, c.arc, &dydt[n - 1])
    return rc


cdef int _event_fn(double t, const double* y, Py_ssize_t n, void* ctx, double* g) noexcept nogil:
    cdef _ev_ctx* c = <_ev_ctx*> ctx
    cdef double M[NM1]
    cdef int rc = P_modes(t, y, c.p, M)
    g[0] = M[c.k]
    return rc


cdef int _constraint_fn(double t, const double* y, Py_ssize_t n, void* ctx, double* g) noexcept nogil:
    cdef _ev_ctx* c = <_ev_ctx*> ctx
    cdef double G[NC1]
    cdef int rc = P_constraint(t, y, c.p, G)
    g[0] = G[c.k]
    return rc


cdef int _rate_fn(double t, const double* y, Py_ssize_t n, void* ctx, double* g) noexcept nogil:
    cdef _ev_ctx* c = <_ev_ctx*> ctx
    cdef double Gd[NC1]
    cdef int rc = P_constraint_rate_arc(t, y, c.p, c.arc, Gd)
    g[0] = Gd[c.k]
    return rc


cdef int _kink_fn(double t, const double* y, Py_ssize_t n, void* ctx, double* g) noexcept nogil:
    cdef _ev_ctx* c = <_ev_ctx*> ctx
    cdef double K[NK1]
    cdef int rc = P_kinks_arc(t, y, c.p, c.arc, K)
    g[0] = K[c.k]
    return rc


cdef class Dynamics(OdeSystem):
    """``z' = F(t, z, p)`` with the optimal control substituted.

    Bang-bang controls switch inside the right-hand side, so the integrator
    steps across each discontinuity. Use :class:`ArcDynamics` (or
    :func:`propagate`) to stop and restart at switches instead.
    """

    def __init__(self, params=None):
        self.n_states = NZ
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.c_fn = _rhs_fn
        self.c_ctx = self._params_ptr()


cdef class ArcDynamics(OdeSystem):
    """``z' = F(t, z, p)`` on a fixed arc: ``arc[k] = 1`` puts bang-bang control k at its upper bound.

    The arc has ``N_MODES`` flags: one per switching function, then one per
    path constraint, 1 where its penalty is on (``g > 0``).

    With ``stm=True`` the state is ``[z, Phi]`` (``N_STM`` values, ``Phi`` the
    NZ x NZ state transition matrix, row-major). With ``param_sensitivity=True``
    as well, ``Psi = dz/dp`` (NZ x NP) is appended (``N_STM_PARAMS`` values).
    """

    cdef _ctx ctx

    def __init__(self, params=None, arc=None, stm=False, param_sensitivity=False):
        if param_sensitivity and not stm:
            raise ValueError("param_sensitivity requires stm=True")
        self.n_states = (NZ + NZ * NZ + (NZ * NP if param_sensitivity else 0)) if stm else NZ
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.ctx.p = self._params_ptr()
        self.ctx.with_p = 1 if param_sensitivity else 0
        self.ctx.with_cost = 0
        self.arc = np.zeros(NM, dtype=np.intc) if arc is None else arc
        self.c_fn = _stm_fn if stm else _rhs_arc_fn
        self.c_ctx = &self.ctx

    @property
    def arc(self):
        return np.array([self.ctx.arc[k] for k in range(NM)], dtype=np.intc)

    @arc.setter
    def arc(self, value):
        a = _arc(value)
        for k in range(NM):
            self.ctx.arc[k] = a[k]


cdef class Switching(EventFunction):
    """Event on switching function ``k``: its zeros are the bang-bang switch times."""

    cdef _ev_ctx ctx

    def __init__(self, int k, params=None, terminal=False, double direction=0.0):
        super().__init__(terminal, direction)
        if not 0 <= k < NSW:
            raise ValueError(f"switching function index {k} out of range ({NSW} functions)")
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.ctx.p = self._params_ptr()
        self.ctx.k = k
        self.c_fn = _event_fn
        self.c_ctx = &self.ctx


cdef class Constraint(EventFunction):
    """Event on path constraint ``c``: its value is ``g``, so direction +1 finds violations."""

    cdef _ev_ctx ctx

    def __init__(self, c, params=None, terminal=False, double direction=0.0):
        super().__init__(terminal, direction)
        if isinstance(c, str):
            c = CONSTRAINT_NAMES.index(c)
        if not 0 <= c < NC:
            raise ValueError(f"path constraint index {c} out of range ({NC} constraints)")
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.ctx.p = self._params_ptr()
        self.ctx.k = c
        self.c_fn = _constraint_fn
        self.c_ctx = &self.ctx


cdef class ConstraintRate(EventFunction):
    """Event on ``dg/dt`` of path constraint ``c`` along the flow on ``arc``.

    Its zeros are the peaks and troughs of ``g``. Between two of them ``g``
    is monotone, so it crosses zero at most once, and FNI splits the step at
    every root it finds, so with this event registered next to
    :class:`Constraint`, a violation inside one step cannot hide. Set
    ``arc`` whenever the flow's arc changes.
    """

    cdef _ev_ctx ctx
    cdef int arc_buf[NM1]

    def __init__(self, c, params=None, arc=None, terminal=False, double direction=0.0):
        super().__init__(terminal, direction)
        if isinstance(c, str):
            c = CONSTRAINT_NAMES.index(c)
        if not 0 <= c < NC:
            raise ValueError(f"path constraint index {c} out of range ({NC} constraints)")
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.ctx.p = self._params_ptr()
        self.ctx.k = c
        self.ctx.arc = self.arc_buf
        self.arc = np.zeros(NM, dtype=np.intc) if arc is None else arc
        self.c_fn = _rate_fn
        self.c_ctx = &self.ctx

    @property
    def arc(self):
        return np.array([self.arc_buf[i] for i in range(NM)], dtype=np.intc)

    @arc.setter
    def arc(self, value):
        a = _arc(value)
        for i in range(NM):
            self.arc_buf[i] = a[i]


cdef class Kink(EventFunction):
    """Event on saturation guard ``k``: zero where a clipped control meets its bound.

    ``F`` is continuous there but its derivative jumps. Restarting at its
    zeros (an identity reset) keeps the steps after one from straddling it,
    so the step-size control does not fight the kink. The state at the
    restart comes from the dense output of the step that found the root, so
    it carries that step's error, at the integration tolerance (as at a
    switch). Set ``arc`` whenever the flow's arc changes.
    """

    cdef _ev_ctx ctx
    cdef int arc_buf[NM1]

    def __init__(self, int k, params=None, arc=None, terminal=False, double direction=0.0):
        super().__init__(terminal, direction)
        if not 0 <= k < NK:
            raise ValueError(f"saturation guard index {k} out of range ({NK} guards)")
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.ctx.p = self._params_ptr()
        self.ctx.k = k
        self.ctx.arc = self.arc_buf
        self.arc = np.zeros(NM, dtype=np.intc) if arc is None else arc
        self.c_fn = _kink_fn
        self.c_ctx = &self.ctx

    @property
    def arc(self):
        return np.array([self.arc_buf[i] for i in range(NM)], dtype=np.intc)

    @arc.setter
    def arc(self, value):
        a = _arc(value)
        for i in range(NM):
            self.arc_buf[i] = a[i]


