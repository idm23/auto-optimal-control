import numpy as np

from libc.string cimport memcpy
from fast_numerical_integration.integrators cimport (
    EventFunction, OdeSystem, fni_event, fni_integrate, fni_options, fni_rhs_fn, fni_stats,
    FNI_DOP853, FNI_OK, FNI_RK23, FNI_RK45, FNI_STATUS_EVENT, FNI_STATUS_FINISHED)

cdef extern from "{{header}}" nogil:
    int P_rhs "{{P}}rhs"(double t, const double* z, const double* p, double* dz)
    int P_rhs_arc "{{P}}rhs_arc"(double t, const double* z, const double* p, const int* arc, double* dz)
    int P_jac_arc "{{P}}jac_arc"(double t, const double* z, const double* p, const int* arc, double* A)
    int P_dfdp_arc "{{P}}dfdp_arc"(double t, const double* z, const double* p, const int* arc, double* B)
    int P_stm_rhs "{{P}}stm_rhs"(double t, const double* y, const double* p, const int* arc, int with_p, double* dy)
    int P_stm_jump "{{P}}stm_jump"(int k, double t, double* y, const double* p, const int* arc, int with_p)
    int P_switching "{{P}}switching"(double t, const double* z, const double* p, double* S)
    int P_switching_grad "{{P}}switching_grad"(double t, const double* z, const double* p, double* St, double* Sz, double* Sp)
    int P_control "{{P}}control"(double t, const double* z, const double* p, double* u)
    int P_hamiltonian "{{P}}hamiltonian"(double t, const double* z, const double* p, double* H)
    int P_cost_rate "{{P}}cost_rate"(double t, const double* z, const double* p, double* L)
    int P_cost_rate_arc "{{P}}cost_rate_arc"(double t, const double* z, const double* p, const int* arc, double* L)
    int P_residual "{{P}}residual"(const double* z0, const double* zf, const double* nu, double tf, const double* p, double* R)
    int P_residual_jac "{{P}}residual_jac"(const double* z0, const double* zf, const double* nu, double tf, const double* p, double* Rz0, double* Rzf, double* Rnu, double* Rtf, double* Rp)

cdef enum:
    NZ = {{NZ}}
    NP = {{NP}}
    NSW = {{NSW}}
    NU = {{NU}}
    NNU = {{NNU}}
    NR = {{NR}}
    NP1 = {{NP1}}
    NSW1 = {{NSW1}}
    NNU1 = {{NNU1}}

N_STATES = NZ // 2
N_Z = NZ
N_PARAMS = NP
N_SWITCHING = NSW
N_CONTROLS = NU
N_MULTIPLIERS = NNU
N_RESIDUALS = NR
N_STM = NZ + NZ * NZ
N_STM_PARAMS = NZ + NZ * NZ + NZ * NP
PARAM_NAMES = {{param_names}}
FREE_FINAL_TIME = {{free_tf}}

_METHODS = {"RK23": FNI_RK23, "RK45": FNI_RK45, "DOP853": FNI_DOP853}


# -----------------------------------------------------------------------------
# Argument helpers
# -----------------------------------------------------------------------------

def _buffer(values, Py_ssize_t n, str what):
    """A contiguous float64 copy of ``values`` with ``n`` entries (padded to >= 1)."""
    if values is None:
        if n:
            raise TypeError(f"{what} is required ({n} values)")
        return np.zeros(1)
    a = np.array(values, dtype=np.float64, copy=True).reshape(-1)
    if a.shape[0] != n:
        raise ValueError(f"{what} must have {n} values, got {a.shape[0]}")
    if n == 0:
        return np.zeros(1)
    return a


def _params(params):
    return _buffer(params, NP, "params")


def _arc(arc):
    out = np.zeros(NSW1, dtype=np.intc)
    if arc is None:
        if NSW:
            raise TypeError(f"arc is required ({NSW} flags)")
        return out
    a = np.asarray(arc).reshape(-1)
    if a.shape[0] != NSW or not np.all((a == 0) | (a == 1)):
        raise ValueError(f"arc must be {NSW} flags of 0 or 1")
    out[:NSW] = a
    return out


cdef int _check(int rc, str what) except -1:
    if rc != 0:
        raise RuntimeError(f"{what} failed with code {rc}")
    return 0


# -----------------------------------------------------------------------------
# FNI adapters
# -----------------------------------------------------------------------------

cdef struct _ctx:
    const double* p
    int arc[NSW1]
    int with_p
    int with_cost       # last entry of the state is J = int L dt


cdef struct _ev_ctx:
    const double* p
    int k


cdef int _rhs_fn(double t, const double* y, double* dydt, Py_ssize_t n, void* ctx) noexcept nogil:
    return P_rhs(t, y, <const double*> ctx, dydt)


cdef int _rhs_arc_fn(double t, const double* y, double* dydt, Py_ssize_t n, void* ctx) noexcept nogil:
    cdef _ctx* c = <_ctx*> ctx
    cdef int rc = P_rhs_arc(t, y, c.p, c.arc, dydt)
    if rc == 0 and c.with_cost:
        rc = P_cost_rate_arc(t, y, c.p, c.arc, &dydt[n - 1])
    return rc


cdef int _stm_fn(double t, const double* y, double* dydt, Py_ssize_t n, void* ctx) noexcept nogil:
    cdef _ctx* c = <_ctx*> ctx
    cdef int rc = P_stm_rhs(t, y, c.p, c.arc, c.with_p, dydt)
    if rc == 0 and c.with_cost:
        rc = P_cost_rate_arc(t, y, c.p, c.arc, &dydt[n - 1])
    return rc


cdef int _event_fn(double t, const double* y, Py_ssize_t n, void* ctx, double* g) noexcept nogil:
    cdef _ev_ctx* c = <_ev_ctx*> ctx
    cdef double S[NSW1]
    cdef int rc = P_switching(t, y, c.p, S)
    g[0] = S[c.k]
    return rc


cdef class Dynamics(OdeSystem):
    """``z' = F(t, z, p)`` with the optimal control substituted.

    Bang-bang controls switch inside the right-hand side, so the integrator
    steps across each discontinuity. Use :class:`ArcDynamics` (or
    :func:`propagate`) to stop and restart at switches instead.
    """

    def __init__(self, params=None):
        self.n_states = NZ
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.c_fn = _rhs_fn
        self.c_ctx = self._params_ptr()


cdef class ArcDynamics(OdeSystem):
    """``z' = F(t, z, p)`` on a fixed arc: ``arc[k] = 1`` puts bang-bang control k at its upper bound.

    With ``stm=True`` the state is ``[z, Phi]`` (``N_STM`` values, ``Phi`` the
    NZ x NZ state transition matrix, row-major). With ``param_sensitivity=True``
    as well, ``Psi = dz/dp`` (NZ x NP) is appended (``N_STM_PARAMS`` values).
    """

    cdef _ctx ctx

    def __init__(self, params=None, arc=None, stm=False, param_sensitivity=False):
        if param_sensitivity and not stm:
            raise ValueError("param_sensitivity requires stm=True")
        self.n_states = (NZ + NZ * NZ + (NZ * NP if param_sensitivity else 0)) if stm else NZ
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.ctx.p = self._params_ptr()
        self.ctx.with_p = 1 if param_sensitivity else 0
        self.ctx.with_cost = 0
        self.arc = np.zeros(NSW, dtype=np.intc) if arc is None else arc
        self.c_fn = _stm_fn if stm else _rhs_arc_fn
        self.c_ctx = &self.ctx

    @property
    def arc(self):
        return np.array([self.ctx.arc[k] for k in range(NSW)], dtype=np.intc)

    @arc.setter
    def arc(self, value):
        a = _arc(value)
        for k in range(NSW):
            self.ctx.arc[k] = a[k]


cdef class Switching(EventFunction):
    """Event on switching function ``k``: its zeros are the bang-bang switch times."""

    cdef _ev_ctx ctx

    def __init__(self, int k, params=None, terminal=False, double direction=0.0):
        super().__init__(terminal, direction)
        if not 0 <= k < NSW:
            raise ValueError(f"switching function index {k} out of range ({NSW} functions)")
        if NP:
            self._init_params(_params(params)[:NP], PARAM_NAMES)
        self.ctx.p = self._params_ptr()
        self.ctx.k = k
        self.c_fn = _event_fn
        self.c_ctx = &self.ctx


# -----------------------------------------------------------------------------
# Pointwise evaluation
# -----------------------------------------------------------------------------

def rhs(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(NZ)
    cdef double[::1] ov = out
    _check(P_rhs(t, &zv[0], &pv[0], &ov[0]), "rhs")
    return out


def rhs_arc(double t, z, params=None, arc=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(arc)
    out = np.zeros(NZ)
    cdef double[::1] ov = out
    _check(P_rhs_arc(t, &zv[0], &pv[0], &av[0], &ov[0]), "rhs_arc")
    return out


def jacobian(double t, z, params=None, arc=None):
    """``dF/dz`` on an arc, shape (NZ, NZ)."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(arc)
    out = np.zeros(NZ * NZ)
    cdef double[::1] ov = out
    _check(P_jac_arc(t, &zv[0], &pv[0], &av[0], &ov[0]), "jacobian")
    return out.reshape(NZ, NZ)


def dfdp(double t, z, params=None, arc=None):
    """``dF/dp`` on an arc, shape (NZ, NP)."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(arc)
    out = np.zeros(max(NZ * NP, 1))
    cdef double[::1] ov = out
    _check(P_dfdp_arc(t, &zv[0], &pv[0], &av[0], &ov[0]), "dfdp")
    return out[:NZ * NP].reshape(NZ, NP)


def control(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(max(NU, 1))
    cdef double[::1] ov = out
    _check(P_control(t, &zv[0], &pv[0], &ov[0]), "control")
    return out[:NU]


def hamiltonian(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef double H
    _check(P_hamiltonian(t, &zv[0], &pv[0], &H), "hamiltonian")
    return H


def cost_rate(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    cdef double L
    _check(P_cost_rate(t, &zv[0], &pv[0], &L), "cost_rate")
    return L


def switching(double t, z, params=None):
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    out = np.zeros(NSW1)
    cdef double[::1] ov = out
    _check(P_switching(t, &zv[0], &pv[0], &ov[0]), "switching")
    return out[:NSW]


def switching_gradient(double t, z, params=None):
    """``(dS/dt (NSW,), dS/dz (NSW, NZ), dS/dp (NSW, NP))``."""
    cdef double[::1] zv = _buffer(z, NZ, "z")
    cdef double[::1] pv = _params(params)
    st, sz, sp_ = np.zeros(NSW1), np.zeros(NSW1 * NZ), np.zeros(NSW1 * NP1)
    cdef double[::1] a = st
    cdef double[::1] b = sz
    cdef double[::1] c = sp_
    _check(P_switching_grad(t, &zv[0], &pv[0], &a[0], &b[0], &c[0]), "switching_gradient")
    return st[:NSW], sz[:NSW * NZ].reshape(NSW, NZ), sp_[:NSW * NP].reshape(NSW, NP)


def initial_arc(double t, z, params=None):
    """The arc at ``(t, z)``: 1 where a switching function is negative (upper bound)."""
    return (switching(t, z, params) < 0).astype(np.intc)


def residual(z0, zf, nu=None, double tf=np.nan, params=None):
    """Boundary residuals (NR,). ``tf`` is used only when the final time is free."""
    cdef double[::1] a = _buffer(z0, NZ, "z0")
    cdef double[::1] b = _buffer(zf, NZ, "zf")
    cdef double[::1] c = _buffer(nu if NNU else None, NNU, "nu")
    cdef double[::1] pv = _params(params)
    out = np.zeros(max(NR, 1))
    cdef double[::1] ov = out
    _check(P_residual(&a[0], &b[0], &c[0], tf, &pv[0], &ov[0]), "residual")
    return out[:NR]


def residual_jacobian(z0, zf, nu=None, double tf=np.nan, params=None):
    """Derivatives of the residuals: dict with ``z0``, ``zf`` (NR, NZ), ``nu`` (NR, NNU),
    ``tf`` (NR,) and ``p`` (NR, NP)."""
    cdef double[::1] a = _buffer(z0, NZ, "z0")
    cdef double[::1] b = _buffer(zf, NZ, "zf")
    cdef double[::1] c = _buffer(nu if NNU else None, NNU, "nu")
    cdef double[::1] pv = _params(params)
    r0, rf = np.zeros(NR * NZ), np.zeros(NR * NZ)
    rn, rt, rp = np.zeros(max(NR * NNU, 1)), np.zeros(max(NR, 1)), np.zeros(max(NR * NP, 1))
    cdef double[::1] v0 = r0
    cdef double[::1] vf = rf
    cdef double[::1] vn = rn
    cdef double[::1] vt = rt
    cdef double[::1] vp = rp
    _check(P_residual_jac(&a[0], &b[0], &c[0], tf, &pv[0], &v0[0], &vf[0], &vn[0], &vt[0], &vp[0]),
           "residual_jacobian")
    return {"z0": r0.reshape(NR, NZ), "zf": rf.reshape(NR, NZ),
            "nu": rn[:NR * NNU].reshape(NR, NNU), "tf": rt[:NR], "p": rp[:NR * NP].reshape(NR, NP)}


def stm_jump(int k, double t, y, params=None, arc=None, param_sensitivity=False):
    """Apply the switch-k jump to ``y = [z, Phi(, Psi)]`` (arc = the arc before); returns a copy."""
    cdef Py_ssize_t ny = NZ + NZ * NZ + (NZ * NP if param_sensitivity else 0)
    out = _buffer(y, ny, "y")
    cdef double[::1] yv = out
    cdef double[::1] pv = _params(params)
    cdef int[::1] av = _arc(arc)
    _check(P_stm_jump(k, t, &yv[0], &pv[0], &av[0], 1 if param_sensitivity else 0), "stm_jump")
    return out


# -----------------------------------------------------------------------------
# Arc-by-arc propagation with the state transition matrix
# -----------------------------------------------------------------------------

cdef enum:
    STATUS_TOO_MANY_SWITCHES = -2
    STATUS_JUMP_FAILED = -3


cdef int _propagate(int method, _ctx* ctx, int stm, Py_ssize_t ny, double t0, double* y,
                    double t1, const fni_options* opt, double* y_out, double* sw_t,
                    int* sw_k, Py_ssize_t max_sw, Py_ssize_t* n_sw, Py_ssize_t* nfev,
                    int* status, double* t_final) noexcept nogil:
    cdef fni_event events[NSW1]
    cdef _ev_ctx evc[NSW1]
    cdef Py_ssize_t rec_e[1]
    cdef double rec_t[1]
    cdef fni_stats st
    cdef int k, rc
    cdef double t = t0
    cdef fni_rhs_fn fn = _stm_fn if stm else _rhs_arc_fn

    for k in range(NSW):
        evc[k].p = ctx.p
        evc[k].k = k
        events[k].fn = _event_fn
        events[k].ctx = &evc[k]
        # On the upper arc S < 0, so the next switch is an upward crossing.
        # Watching only that direction ignores the round-off sign of S right
        # at a restart.
        events[k].direction = 1.0 if ctx.arc[k] else -1.0
        events[k].max_events = 1.0
    n_sw[0] = 0
    nfev[0] = 0
    while True:
        rc = fni_integrate(method, fn, ctx, ny, t, y, t1, opt, events, NSW, y_out,
                           rec_e, rec_t, NULL, 1, &st)
        if rc != FNI_OK:
            return rc
        nfev[0] += st.nfev
        t = st.t_final
        t_final[0] = t
        if st.status != FNI_STATUS_EVENT:
            status[0] = st.status
            return FNI_OK
        k = <int> rec_e[0]
        if n_sw[0] >= max_sw:
            status[0] = STATUS_TOO_MANY_SWITCHES
            return FNI_OK
        sw_t[n_sw[0]] = t
        sw_k[n_sw[0]] = k
        n_sw[0] += 1
        if stm:
            if P_stm_jump(k, t, y_out, ctx.p, ctx.arc, ctx.with_p) != 0:
                status[0] = STATUS_JUMP_FAILED
                return FNI_OK
        ctx.arc[k] = 1 - ctx.arc[k]
        events[k].direction = -events[k].direction
        memcpy(y, y_out, ny * sizeof(double))
        if t == t1:
            status[0] = FNI_STATUS_FINISHED
            return FNI_OK


cdef int _setup_options(fni_options* opt, double rtol, double atol, first_step,
                        double max_step) except -1:
    if not max_step > 0:
        raise ValueError("max_step must be positive")
    opt.rtol = rtol
    opt.rtol_vec = NULL
    opt.atol = atol
    opt.atol_vec = NULL
    opt.first_step = -1.0 if first_step is None else float(first_step)
    opt.max_step = max_step
    return 0


def _layout(stm, param_sensitivity, cost):
    if param_sensitivity and not stm:
        raise ValueError("param_sensitivity requires stm=True")
    return NZ + (NZ * NZ if stm else 0) + (NZ * NP if param_sensitivity else 0) + (1 if cost else 0)


def _initial_y(z, stm, Py_ssize_t ny):
    y = np.zeros(ny)
    y[:NZ] = z
    if stm:
        y[NZ:NZ + NZ * NZ] = np.eye(NZ).reshape(-1)
    return y


def propagate(double t0, z0, double t1, params=None, *, stm=False, param_sensitivity=False,
              cost=False, arc=None, method="DOP853", double rtol=1e-10, double atol=1e-12,
              first_step=None, double max_step=np.inf, Py_ssize_t max_switches=10000):
    """Integrate the extremal from ``z0 = [x0, lambda0]`` from ``t0`` to ``t1``.

    The integration runs arc by arc and stops at every switch, so each
    bang-bang arc is integrated with its control fixed and no step straddles
    a discontinuity. Runs without the GIL. This is the forward map
    ``lambda0 -> trajectory``; it knows nothing about how ``lambda0`` was chosen.

    Parameters
    ----------
    stm : bool
        Also propagate the state transition matrix ``Phi = dz(t1)/dz(t0)``,
        including its jump at every switch.
    param_sensitivity : bool
        Also propagate ``Psi = dz(t1)/dp`` (requires ``stm``).
    cost : bool
        Also accumulate ``J = int_{t0}^{t1} L dt`` (the running cost at ``u*``).
    arc : array_like of 0/1, optional
        The arc at ``t0``. By default, from the signs of the switching functions.

    Returns
    -------
    dict
        ``t`` (final time), ``z`` (NZ,), ``stm`` (NZ, NZ) or None, ``dz_dp``
        (NZ, NP) or None, ``cost`` (float) or None, ``dz_dt1`` (the dynamics
        at the end, NZ), ``switch_times``, ``switch_index``, ``arc0``, ``arc``
        (final), ``nfev`` and ``status`` (0 finished, -1 step size too small,
        -2 too many switches, -3 tangential switch).
    """
    cdef fni_options opt
    cdef _ctx ctx
    cdef Py_ssize_t ny, n_sw = 0, nfev = 0, k
    cdef int status = 0, meth, rc
    cdef double t_final = t0
    cdef int do_stm = 1 if stm else 0

    ny = _layout(stm, param_sensitivity, cost)
    if method not in _METHODS:
        raise ValueError(f"method must be one of {list(_METHODS)}")
    meth = _METHODS[method]
    if max_switches < 0:
        raise ValueError("max_switches must be >= 0")
    _setup_options(&opt, rtol, atol, first_step, max_step)
    z = _buffer(z0, NZ, "z0")
    p_arr = _params(params)
    arc0 = initial_arc(t0, z[:NZ], p_arr[:NP] if NP else None) if arc is None else _arc(arc)[:NSW]
    arc_buf = _arc(arc0)

    y = _initial_y(z[:NZ], stm, ny)
    y_out = np.zeros(ny)
    sw_t = np.zeros(max(max_switches, 1))
    sw_k = np.zeros(max(max_switches, 1), dtype=np.intc)

    cdef double[::1] pv = p_arr
    cdef double[::1] yv = y
    cdef double[::1] yo = y_out
    cdef double[::1] tv = sw_t
    cdef int[::1] kv = sw_k
    ctx.p = &pv[0]
    ctx.with_p = 1 if param_sensitivity else 0
    ctx.with_cost = 1 if cost else 0
    for k in range(NSW):
        ctx.arc[k] = arc_buf[k]

    with nogil:
        rc = _propagate(meth, &ctx, do_stm, ny, t0, &yv[0], t1, &opt, &yo[0], &tv[0], &kv[0],
                        max_switches, &n_sw, &nfev, &status, &t_final)
    if rc != FNI_OK:
        raise RuntimeError(f"integration failed with code {rc}")

    arc_end = np.array([ctx.arc[k] for k in range(NSW)], dtype=np.intc)
    o = NZ + NZ * NZ
    return {
        "t": t_final,
        "z": y_out[:NZ].copy(),
        "stm": y_out[NZ:o].reshape(NZ, NZ).copy() if stm else None,
        "dz_dp": y_out[o:o + NZ * NP].reshape(NZ, NP).copy() if param_sensitivity else None,
        "cost": float(y_out[ny - 1]) if cost else None,
        "dz_dt1": rhs_arc(t_final, y_out[:NZ], p_arr[:NP] if NP else None,
                          arc_end if NSW else None),
        "switch_times": sw_t[:n_sw].copy(),
        "switch_index": sw_k[:n_sw].astype(np.intp),
        "arc0": np.asarray(arc0, dtype=np.intc),
        "arc": arc_end,
        "nfev": nfev,
        "status": status,
    }


cdef int _propagate_rows(int meth, int do_stm, int with_p, int with_cost, Py_ssize_t ny,
                         const double* p, const double[::1] t0, const double[::1] t1,
                         double[:, ::1] y, double[:, ::1] y_out, const int[:, ::1] arc0,
                         int[:, ::1] arc_end, double[:, ::1] sw_t, int[:, ::1] sw_k,
                         Py_ssize_t max_sw, Py_ssize_t[::1] n_sw, Py_ssize_t[::1] nfev,
                         int[::1] status, double[::1] t_final, const fni_options* opt,
                         Py_ssize_t start, Py_ssize_t stop) noexcept nogil:
    cdef _ctx ctx
    cdef Py_ssize_t r, k
    cdef int rc
    ctx.p = p
    ctx.with_p = with_p
    ctx.with_cost = with_cost
    for r in range(start, stop):
        for k in range(NSW):
            ctx.arc[k] = arc0[r, k]
        rc = _propagate(meth, &ctx, do_stm, ny, t0[r], &y[r, 0], t1[r], opt, &y_out[r, 0],
                        &sw_t[r, 0], &sw_k[r, 0], max_sw, &n_sw[r], &nfev[r], &status[r],
                        &t_final[r])
        if rc != FNI_OK:
            return rc
        for k in range(NSW):
            arc_end[r, k] = ctx.arc[k]
    return FNI_OK


def propagate_batch(t0, z0, t1, params=None, *, stm=False, param_sensitivity=False, cost=False,
                    arc=None, method="DOP853", double rtol=1e-10, double atol=1e-12,
                    first_step=None, double max_step=np.inf, Py_ssize_t max_switches=64,
                    n_threads=1):
    """:func:`propagate` for many initial states at once, without the GIL.

    ``z0`` has shape (m, NZ); ``t0`` and ``t1`` are scalars or length-m
    arrays. All rows share ``params``. With ``n_threads > 1`` the rows are
    split across threads that run in parallel. Each row gives exactly the
    result of :func:`propagate`.

    Returns a dict of arrays with a leading dimension m: ``t``, ``z``,
    ``stm``, ``dz_dp``, ``cost`` (None when not requested), ``switch_times``
    (m, max_switches; NaN past ``n_switches``), ``switch_index`` (-1 past it),
    ``n_switches``, ``arc0``, ``arc``, ``nfev`` and ``status``.
    """
    cdef fni_options opt
    cdef Py_ssize_t m, ny, r, k
    cdef int meth
    from concurrent.futures import ThreadPoolExecutor

    ny = _layout(stm, param_sensitivity, cost)
    if method not in _METHODS:
        raise ValueError(f"method must be one of {list(_METHODS)}")
    meth = _METHODS[method]
    if max_switches < 0:
        raise ValueError("max_switches must be >= 0")
    _setup_options(&opt, rtol, atol, first_step, max_step)
    Z = np.array(z0, dtype=np.float64, ndmin=2)
    if Z.ndim != 2 or Z.shape[1] != NZ:
        raise ValueError(f"z0 must have shape (m, {NZ})")
    m = Z.shape[0]
    t0_arr = np.array(np.broadcast_to(np.asarray(t0, dtype=np.float64), (m,)))
    t1_arr = np.array(np.broadcast_to(np.asarray(t1, dtype=np.float64), (m,)))
    p_arr = _params(params)
    arcs0 = np.zeros((m, NSW1), dtype=np.intc)
    if arc is None:
        for r in range(m):
            arcs0[r, :NSW] = initial_arc(t0_arr[r], Z[r], p_arr[:NP] if NP else None)
    else:
        a = np.asarray(arc).reshape(-1, NSW) if NSW else np.zeros((1, 0))
        arcs0[:, :NSW] = np.broadcast_to(a, (m, NSW))
        if not np.all((arcs0 == 0) | (arcs0 == 1)):
            raise ValueError("arc flags must be 0 or 1")

    y = np.zeros((m, ny))
    y[:, :NZ] = Z
    if stm:
        y[:, NZ:NZ + NZ * NZ] = np.eye(NZ).reshape(-1)
    y_out = np.zeros((m, ny))
    arc_end = np.zeros((m, NSW1), dtype=np.intc)
    msw = max(max_switches, 1)
    sw_t = np.full((m, msw), np.nan)
    sw_k = np.full((m, msw), -1, dtype=np.intc)
    n_sw = np.zeros(m, dtype=np.intp)
    nfev = np.zeros(m, dtype=np.intp)
    status = np.zeros(m, dtype=np.intc)
    t_final = np.zeros(m)

    cdef const double[::1] pv = p_arr
    cdef const double[::1] t0v = t0_arr
    cdef const double[::1] t1v = t1_arr
    cdef double[:, ::1] yv = y
    cdef double[:, ::1] yov = y_out
    cdef const int[:, ::1] a0v = arcs0
    cdef int[:, ::1] aev = arc_end
    cdef double[:, ::1] swtv = sw_t
    cdef int[:, ::1] swkv = sw_k
    cdef Py_ssize_t[::1] nswv = n_sw
    cdef Py_ssize_t[::1] nfv = nfev
    cdef int[::1] stv = status
    cdef double[::1] tfv = t_final
    cdef int do_stm = 1 if stm else 0
    cdef int with_p = 1 if param_sensitivity else 0
    cdef int with_cost = 1 if cost else 0

    def run(Py_ssize_t start, Py_ssize_t stop):
        cdef int rc
        with nogil:
            rc = _propagate_rows(meth, do_stm, with_p, with_cost, ny, &pv[0], t0v, t1v, yv, yov,
                                 a0v, aev, swtv, swkv, max_switches, nswv, nfv, stv, tfv, &opt,
                                 start, stop)
        if rc != FNI_OK:
            raise RuntimeError(f"integration failed with code {rc}")

    if m:
        n_threads = max(1, min(int(n_threads), m))
        if n_threads == 1:
            run(0, m)
        else:
            bounds = np.linspace(0, m, n_threads + 1).astype(int)
            with ThreadPoolExecutor(n_threads) as pool:
                for fut in [pool.submit(run, int(a), int(b)) for a, b in zip(bounds[:-1], bounds[1:])]:
                    fut.result()

    o = NZ + NZ * NZ
    return {
        "t": t_final,
        "z": y_out[:, :NZ].copy(),
        "stm": y_out[:, NZ:o].reshape(m, NZ, NZ).copy() if stm else None,
        "dz_dp": y_out[:, o:o + NZ * NP].reshape(m, NZ, NP).copy() if param_sensitivity else None,
        "cost": y_out[:, ny - 1].copy() if cost else None,
        "switch_times": sw_t[:, :max_switches],
        "switch_index": sw_k[:, :max_switches].astype(np.intp),
        "n_switches": n_sw,
        "arc0": arcs0[:, :NSW].copy(),
        "arc": arc_end[:, :NSW].copy(),
        "nfev": nfev,
        "status": status,
    }
